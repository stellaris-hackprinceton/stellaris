.env
.env.*
!.env.example

# Local tools and generated repository graphs.
/.local/
/graphify-out/

# macOS folder metadata.
.DS_Store

# Brag video: track the finished video plus the source needed to re-render it
# (composition2/, render/capture scripts, final music bed). Rendered frames, stills,
# screenshots, music previews and older cuts are regenerable and stay untracked.
/brag-output/*
!/brag-output/brag.mp4
!/brag-output/Stellaris-readme-720p.mp4
!/brag-output/brag.jpg
!/brag-output/share-copy.txt
!/brag-output/brag-plan.md
!/brag-output/composition2/
!/brag-output/work/
/brag-output/work/*
!/brag-output/work/render.cjs
!/brag-output/work/capture.cjs
!/brag-output/work/capture2.cjs
!/brag-output/work/music2.m4a
# Local design-tool config and session notes (not needed to build or run Stellaris).
.impeccable/
frontend/.impeccable/
.graphifyignore
/BACKEND_ACHIEVEMENTS.md
/REPORT_ANALYSIS_TODO.md
/WORK_ENERGY_TEST_ISSUES.md
