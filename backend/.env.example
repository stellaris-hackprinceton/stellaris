STELLARIS_MODEL_PROVIDER=bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Optional provider. It is used only when STELLARIS_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional, non-secret overrides. Blank means "use the default".
STELLARIS_API_PORT=
STELLARIS_PROJECT_MEMORY_MB=
STELLARIS_PROJECT_CPUS=
DOCKER_SOCKET_PATH=
STELLARIS_UPLOAD_EXPIRY_S=
STELLARIS_MAX_FILE_BYTES=
STELLARIS_MAX_VIDEO_DURATION_MS=
STELLARIS_MAX_PROJECT_BYTES=
STELLARIS_MEDIA_PROBE_TIMEOUT_S=
STELLARIS_EVENT_RETENTION_S=
# Scientific workers (temporary container per analysis run).
STELLARIS_WORKER_MEMORY_MB=
STELLARIS_WORKER_CPUS=
STELLARIS_WORKER_WALL_TIME_S=
STELLARIS_WORKER_PIDS_LIMIT=
STELLARIS_WORKER_OUTPUT_MB=
STELLARIS_WORKER_TMP_MB=
STELLARIS_MAX_CONCURRENT_RUNS=
STELLARIS_MAX_LOG_CHUNK_BYTES=
STELLARIS_MAX_RUN_LOG_BYTES=

# File workspace catalogs (backend-owned API volume; defaults /data/catalogs and 64 MiB).
STELLARIS_CATALOG_DIR=
STELLARIS_MAX_NOTE_BYTES=

# Optional HPC transport. Blank host keeps remote execution disabled.
STELLARIS_SLURM_HOST=
STELLARIS_SLURM_PORT=
STELLARIS_SLURM_USER=
STELLARIS_SLURM_CLUSTER_KIND=
STELLARIS_SLURM_CLUSTER_LABEL=
STELLARIS_SLURM_UNSQUASH=
STELLARIS_SLURM_MAX_QUEUE_WAIT_S=
STELLARIS_SLURM_MAX_CONCURRENT_RUNS=
# Credential-free terminal runtime; defaults are documented in docs/terminal-contract.md.
STELLARIS_TERMINAL_IMAGE=
STELLARIS_TERMINAL_DURATION_S=
STELLARIS_TERMINAL_CPUS=
STELLARIS_TERMINAL_MEMORY_MB=
STELLARIS_TERMINAL_PIDS=
